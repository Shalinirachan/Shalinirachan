.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #4caf50;
  color: #fff;
  padding: 12px 24px;
  font-family: Arial, sans-serif;
  position: sticky;
  top: 0;
  z-index: 10;
}

.navbar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #fff;
  text-decoration: none;
}

.navbar-logo {
  width: 50px;
  height: 50px;
  object-fit: contain;
}

.navbar-title {
  margin: 0;
  font-size: 1.4rem;
}

.navbar-subtitle {
  font-size: 0.85rem;
}

.navbar-links {
  display: flex;
  align-items: center;
  gap: 32px;
}

.navbar-links a {
  color: #fff;
  text-decoration: none;
  font-size: 1.3rem;
}

.cart-link {
  position: relative;
  display: inline-flex;
}

.cart-count {
  position: absolute;
  top: 6px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 1rem;
  font-weight: bold;
  color: #faf9f9;
}

.product-grid {
  font-family: Arial, sans-serif;
  padding: 16px 24px;
}

.category-title {
  text-align: center;
  color: #2e7d32;
  margin-top: 32px;
}

.product-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
}

.product-card {
  width: 260px;
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 16px;
  text-align: center;
  background: #fff;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 6px;
}

.product-title {
  font-size: 1.2rem;
  font-weight: bold;
  margin: 10px 0 4px;
}

.product-description {
  font-size: 0.95rem;
  color: #555;
  min-height: 48px;
}

.product-cost {
  font-size: 1.1rem;
  font-weight: bold;
  color: #2e7d32;
  margin: 8px 0;
}

.product-button {
  padding: 10px 22px;
  border: none;
  border-radius: 6px;
  background: #2e7d32;
  color: #fff;
  font-size: 1rem;
  cursor: pointer;
}

.product-button:hover:not(:disabled) {
  background: #1b5e20;
}

.product-button.added,
.product-button:disabled {
  background: #9e9e9e;
  cursor: not-allowed;
}
